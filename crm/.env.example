# API/shared staging template; synthetic seed generates private api.env and worker.env.
CRM_DATABASE_URL=postgresql+psycopg://crm@127.0.0.1:55432/crm_staging_demo
CRM_JWT_SECRET=
CRM_SYNC_SECRET=
CRM_BUSINESSES=synthetic_one,synthetic_two
CRM_SOURCE_MODE=synthetic
NOTIFICATIONS_ENABLED=false
SYNC_INTERVAL_SECONDS=30
SYNC_PAGE_SIZE=500
SYNC_MAX_PAGES=20
SYNC_MAX_SECONDS=15
SYNC_MAX_REQUESTS=100
SYNC_MAX_CONNECTIONS=1
SYNC_MAX_PROJECTIONS=50
SYNC_MAX_HISTORY_MESSAGES=10000
SYNC_RECONCILE_INTERVAL_SECONDS=3600
SYNC_BACKOFF_BASE_SECONDS=30
SYNC_BACKOFF_MAX_SECONDS=1800
# Worker ONLY: dedicated synthetic reader connections, never bot administrative keys.
# SYNTHETIC_ONE_SOURCE_READONLY_DATABASE_URL=
# SYNTHETIC_TWO_SOURCE_READONLY_DATABASE_URL=
SYNTHETIC_ONE_CHATWOOT_APP_URL=
SYNTHETIC_ONE_CHATWOOT_ACCOUNT_ID=
SYNTHETIC_TWO_CHATWOOT_APP_URL=
SYNTHETIC_TWO_CHATWOOT_ACCOUNT_ID=
