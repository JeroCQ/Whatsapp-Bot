+              </div>
+              <section
+                aria-label="Historial de mensajes"
+                className="max-h-[55vh] flex-1 space-y-3 overflow-auto p-4"
+              >
+                {olderCursor && (
+                  <Button size="sm" variant="outline" onClick={() => void loadOlder()}>
+                    Cargar mensajes anteriores
+                  </Button>
+                )}
+                {messages.map((item) => (
+                  <article
+                    key={item.id}
+                    className={`max-w-[90%] rounded-lg border border-border p-3 text-sm ${item.role === "user" ? "bg-panel" : "ml-auto bg-secondary"}`}
+                  >
+                    <div className="mb-1 text-xs font-semibold text-muted-foreground">
+                      {item.role === "user"
+                        ? "Cliente"
+                        : item.role === "asesor"
+                          ? "Asesor"
+                          : item.role === "model"
+                            ? "IA"
+                            : "Sistema"}{" "}
+                      · {new Date(item.created_at).toLocaleString("es-CO")}
+                    </div>
+                    <p className="whitespace-pre-wrap break-words">{item.content}</p>
+                    {typeof item.metadata["delivery_status"] === "string" && (
+                      <p className="mt-1 text-xs text-muted-foreground">
+                        {COMMAND_LABELS[
+                          item.metadata["delivery_status"] as keyof typeof COMMAND_LABELS
+                        ] ?? item.metadata["delivery_status"]}
+                      </p>
+                    )}
+                  </article>
+                ))}
+              </section>
+              <form
+                onSubmit={(event) => {
+                  event.preventDefault();
+                  void execute("messages");
+                }}
+                className="space-y-2 border-t border-border bg-panel p-4"
+              >
+                <label htmlFor="crm-reply" className="block text-sm font-semibold">
+                  Respuesta humana
+                </label>
+                <Textarea
+                  id="crm-reply"
+                  value={draft}
+                  maxLength={4096}
+                  disabled={!compose}
+                  onChange={(event) =>
+                    setDrafts((previous) => ({ ...previous, [selectedPhone]: event.target.value }))
+                  }
+                  placeholder="Toma el control y espera la pausa confirmada para responder."
+                />
+                <div className="flex items-center justify-between gap-3 text-xs text-muted-foreground">
+                  <span>{draft.length}/4096 · Solo texto dentro de la ventana de WhatsApp.</span>
+                  <Button type="submit" disabled={!compose || !draft.trim()}>
+                    Enviar respuesta
+                  </Button>
+                </div>
+                {mine && !control?.can_send && (
+                  <p className="text-xs">
+                    El bot no habilita el envío: revisa la ventana de WhatsApp o un intento todavía
+                    pendiente.
+                  </p>
+                )}
+              </form>
+            </main>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/lib/crm-pilot-contract.ts b/src/lib/crm-pilot-contract.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/crm-pilot-contract.ts
@@ -0,0 +1,90 @@
+/** Operational CRM wire contract. This module contains no credentials or server configuration. */
+export type CrmBucket = "awaiting_human" | "human_active" | "ai_active" | "closed" | "all";
+export interface CrmConversation {
+  business_id: string;
+  phone_number: string;
+  name: string | null;
+  bucket: Exclude<CrmBucket, "all">;
+  waiting_seconds: number;
+  unanswered_customer_count: number;
+  priority: number;
+  priority_reason: string;
+  read: boolean;
+  data_quality_warnings: string[];
+}
+export interface CrmMessage {
+  id: number;
+  role: "user" | "model" | "asesor" | "system";
+  content: string;
+  created_at: string;
+  metadata: Record<string, unknown>;
+}
+export interface CrmDetail extends CrmConversation {
+  messages: CrmMessage[];
+  next_cursor: string | null;
+}
+export interface CrmControl {
+  business_id: string;
+  phone_number: string;
+  provider: "crm";
+  phase: "ai" | "waiting" | "pausing" | "human";
+  version: number;
+  owner: string | null;
+  is_paused: boolean;
+  confirmed: boolean;
+  can_send: boolean;
+  window_expires_at: string | null;
+}
+export type CrmCommandStatus =
+  | "confirmed"
+  | "pending"
+  | "accepted"
+  | "delivered"
+  | "read"
+  | "failed"
+  | "unknown"
+  | "rejected"
+  | "not_forwarded";
+export interface CrmCommandResult {
+  command_id: string;
+  status: CrmCommandStatus;
+  control: CrmControl | null;
+  provider_message_id?: string | null;
+  error?: string;
+}
+export const BUCKET_LABELS: Record<CrmBucket, string> = {
+  awaiting_human: "Por responder",
+  human_active: "En gestión",
+  ai_active: "IA atendiendo",
+  closed: "Cerradas",
+  all: "Todas",
+};
+export const COMMAND_LABELS: Record<CrmCommandStatus, string> = {
+  confirmed: "Confirmado",
+  pending: "Pendiente",
+  accepted: "Aceptado por WhatsApp",
+  delivered: "Entregado",
+  read: "Leído",
+  failed: "Envío fallido",
+  unknown: "Resultado incierto",
+  rejected: "Rechazado",
+  not_forwarded: "No enviado al bot",
+};
+export function commandUnsettled(result: CrmCommandResult | null): boolean {
+  return result?.status === "pending" || result?.status === "unknown";
+}
+export function canCompose(
+  control: CrmControl | null,
+  actor: string,
+  result: CrmCommandResult | null,
+): boolean {
+  return (
+    !!control &&
+    control.phase === "human" &&
+    control.is_paused &&
+    control.confirmed &&
+    control.can_send &&
+    control.owner === actor &&
+    !commandUnsettled(result)
+  );
+}
diff --git a/src/lib/crm-pilot.server.ts b/src/lib/crm-pilot.server.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/crm-pilot.server.ts
@@ -0,0 +1,238 @@
+/** Server-only pilot gateway. Never import this module from a browser component. */
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+type Env = Record<string, string | undefined>;
+type Fetcher = typeof fetch;
+interface Config {
+  business: string;
+  actor: string;
+  operatorSecret: string;
+  jwtSecret: string;
+  origin: string;
+}
+const PREFIX = "/api/public/crm-pilot/";
+const COMMON_HEADERS = {
+  "Content-Type": "application/json",
+  "Cache-Control": "no-store",
+  Vary: "Authorization",
+};
+const COMMAND_ID = /^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$/;
+const INBOX_PARAMS = new Set([
+  "bucket",
+  "search",
+  "cursor",
+  "limit",
+  "priority",
+  "assigned_to",
+  "tag",
+  "stage",
+]);
+function json(data: unknown, status = 200): Response {
+  return new Response(JSON.stringify(data), { status, headers: COMMON_HEADERS });
+}
+function equal(left: string, right: string): boolean {
+  const a = Buffer.from(left),
+    b = Buffer.from(right);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+function config(env: Env): Config | null {
+  if (env["CRM_PILOT_ENABLED"] !== "true") return null;
+  const business = env["CRM_PILOT_BUSINESS_ID"] ?? "briosos";
+  const actor = env["CRM_PILOT_OPERATOR_ID"] ?? "";
+  const operatorSecret = env["CRM_PILOT_OPERATOR_SECRET"] ?? "";
+  const jwtSecret = env["CRM_JWT_SECRET"] ?? "";
+  if (
+    !/^[a-z][a-z0-9_]{0,62}$/.test(business) ||
+    !/^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,199}$/.test(actor) ||
+    actor === business ||
+    ["admin", "tanaka", "memos", "velvet"].includes(actor) ||
+    operatorSecret.length < 32 ||
+    jwtSecret.length < 32 ||
+    equal(operatorSecret, jwtSecret) ||
+    Object.entries(env).some(
+      ([key, value]) => key.startsWith("PASSWORD_") && value && equal(operatorSecret, value),
+    )
+  ) {
+    throw new Error("pilot_configuration_invalid");
+  }
+  const target = new URL(env["CRM_BACKEND_URL"] ?? "");
+  if (
+    target.protocol !== "https:" ||
+    target.username ||
+    target.password ||
+    target.search ||
+    target.hash ||
+    !["", "/"].includes(target.pathname)
+  ) {
+    throw new Error("pilot_origin_invalid");
+  }
+  return { business, actor, operatorSecret, jwtSecret, origin: target.origin };
+}
+function jwt(settings: Config): string {
+  const at = Math.floor(Date.now() / 1000);
+  const part = (value: unknown) => Buffer.from(JSON.stringify(value)).toString("base64url");
+  const head = part({ alg: "HS256", typ: "JWT" });
+  const body = part({
+    iss: "chatty-catalog-compass",
+    aud: "whatsapp-crm",
+    profile: settings.actor,
+    allowed_businesses: [settings.business],
+    iat: at,
+    exp: at + 120,
+  });
+  const signature = createHmac("sha256", settings.jwtSecret)
+    .update(`${head}.${body}`)
+    .digest("base64url");
+  return `${head}.${body}.${signature}`;
+}
+interface Destination {
+  path: string;
+  methods: string[];
+  query: Set<string>;
+  body?: Set<string>;
+  command?: boolean;
+}
+function destination(path: string, business: string): Destination | null {
+  if (path === "capabilities")
+    return { path: "/v1/capabilities", methods: ["GET"], query: new Set() };
+  if (path === "inbox") return { path: "/v1/inbox", methods: ["GET"], query: INBOX_PARAMS };
+  const match =
+    /^conversations\/([^/]+)(?:\/(control|take|messages|close|read|commands\/([^/]+)))?$/.exec(
+      path,
+    );
+  if (!match?.[1]) return null;
+  let phone: string;
+  try {
+    phone = decodeURIComponent(match[1]);
+  } catch {
+    return null;
+  }
+  if (!/^[A-Za-z0-9_.:+-]{1,200}$/.test(phone)) return null;
+  const base = `/v1/conversations/${encodeURIComponent(business)}/${encodeURIComponent(phone)}`;
+  const suffix = match[2];
+  if (!suffix) return { path: base, methods: ["GET"], query: new Set(["cursor", "limit"]) };
+  if (suffix === "control") return { path: base + "/control", methods: ["GET"], query: new Set() };
+  if (suffix.startsWith("commands/")) {
+    if (!match[3] || !COMMAND_ID.test(match[3])) return null;
+    return {
+      path: base + "/commands/" + encodeURIComponent(match[3]),
+      methods: ["GET"],
+      query: new Set(),
+    };
+  }
+  const body =
+    suffix === "read"
+      ? new Set(["read"])
+      : new Set(["command_id", "expected_version", suffix === "messages" ? "text" : "reason"]);
+  return {
+    path: base + "/" + suffix,
+    methods: ["POST"],
+    query: new Set(),
+    body,
+    command: suffix !== "read",
+  };
+}
+export async function handleCrmPilot(
+  request: Request,
+  env: Env,
+  fetcher: Fetcher = fetch,
+): Promise<Response> {
+  const incoming = new URL(request.url);
+  if (!incoming.pathname.startsWith(PREFIX)) return json({ detail: "Not found" }, 404);
+  const path = incoming.pathname.slice(PREFIX.length);
+  let settings: Config | null;
+  try {
+    settings = config(env);
+  } catch {
+    return json({ detail: "El piloto no está configurado correctamente." }, 503);
+  }
+  if (path === "availability" && request.method === "GET") {
+    return json({ enabled: !!settings, business_id: settings?.business ?? null });
+  }
+  if (!settings) return json({ detail: "El piloto CRM está deshabilitado." }, 404);
+  const origin = request.headers.get("origin");
+  const site = request.headers.get("sec-fetch-site");
+  if ((origin && origin !== incoming.origin) || (site && !["same-origin", "none"].includes(site))) {
+    return json({ detail: "Solo se permiten llamadas desde este panel." }, 403);
+  }
+  const authorization = request.headers.get("authorization") ?? "";
+  if (
+    !authorization.startsWith("Bearer ") ||
+    !equal(authorization.slice(7), settings.operatorSecret)
+  ) {
+    return json({ detail: "Credencial personal de piloto inválida." }, 401);
+  }
+  if (path === "session") {
+    if (request.method !== "POST" || incoming.search)
+      return json({ detail: "Método no permitido." }, 405);
+    return json({ profile: settings.actor, business_id: settings.business });
+  }
+  const route = destination(path, settings.business);
+  if (!route) return json({ detail: "Endpoint no permitido." }, 404);
+  if (!route.methods.includes(request.method)) return json({ detail: "Método no permitido." }, 405);
+  const target = new URL(route.path, settings.origin);
+  for (const [key, value] of incoming.searchParams) {
+    if (key === "business_id") {
+      if (value !== settings.business)
+        return json({ detail: "Empresa fuera del alcance del piloto." }, 403);
+    } else if (!route.query.has(key)) return json({ detail: "Parámetro no permitido." }, 400);
+    else target.searchParams.append(key, value);
+  }
+  if (path === "inbox") target.searchParams.set("business_id", settings.business);
+  let body: string | undefined;
+  let commandId: string | undefined;
+  if (request.method !== "GET") {
+    let input: unknown;
+    try {
+      input = await request.json();
+    } catch {
+      return json({ detail: "JSON inválido." }, 400);
+    }
+    if (!input || typeof input !== "object" || Array.isArray(input))
+      return json({ detail: "Cuerpo inválido." }, 400);
+    const payload = input as Record<string, unknown>;
+    if (Object.keys(payload).some((key) => !route.body?.has(key)))
+      return json({ detail: "Campo no permitido." }, 400);
+    if (route.command) {
+      if (typeof payload["command_id"] !== "string" || !COMMAND_ID.test(payload["command_id"])) {
+        return json({ detail: "Identificador de comando inválido." }, 422);
+      }
+      commandId = payload["command_id"];
+    }
+    body = JSON.stringify(payload);
+  }
+  const headers: Record<string, string> = {
+    Authorization: "Bearer " + jwt(settings),
+    Accept: "application/json",
+  };
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  // Build headers from scratch: Origin, Sec-Fetch-Site, the personal credential,
+  // cookies and client-supplied destination/actor never reach the CRM.
+  try {
+    const upstream = await fetcher(target, {
+      method: request.method,
+      headers,
+      ...(body === undefined ? {} : { body }),
+      redirect: "error",
+      cache: "no-store",
+      signal: AbortSignal.timeout(55_000),
+    });
+    const data: unknown = await upstream.json();
+    if (upstream.status >= 500) throw new Error("upstream_unavailable");
+    return json(data, upstream.status);
+  } catch {
+    // The CRM may already have forwarded a POST. Never retry here or in the UI.
+    if (commandId)
+      return json(
+        {
+          command_id: commandId,
+          status: "unknown",
+          control: null,
+          provider_message_id: null,
+          error: "proxy_outcome_unknown_query_command",
+        },
+        202,
+      );
+    return json({ detail: "No se pudo consultar el CRM. No se cambia el control del bot." }, 503);
+  }
+}
diff --git a/src/lib/crm-pilot.server.test.mjs b/src/lib/crm-pilot.server.test.mjs
new file mode 100644
--- /dev/null
+++ b/src/lib/crm-pilot.server.test.mjs
@@ -0,0 +1,302 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import { handleCrmPilot } from "./crm-pilot.server.ts";
+import { canCompose, commandUnsettled } from "./crm-pilot-contract.ts";
+const env = {
+  CRM_PILOT_ENABLED: "true",
+  CRM_PILOT_BUSINESS_ID: "briosos",
+  CRM_PILOT_OPERATOR_ID: "employee-pilot-001",
+  CRM_PILOT_OPERATOR_SECRET: "synthetic-personal-" + "p".repeat(40),
+  CRM_JWT_SECRET: "synthetic-jwt-" + "j".repeat(40),
+  CRM_BACKEND_URL: "https://crm.example",
+};
+const base = "https://frontend.example/api/public/crm-pilot/";
+function incoming(
+  path,
+  { method = "GET", body, auth = env.CRM_PILOT_OPERATOR_SECRET, headers = {} } = {},
+) {
+  return new Request(base + path, {
+    method,
+    headers: {
+      Authorization: "Bearer " + auth,
+      ...(body === undefined ? {} : { "Content-Type": "application/json" }),
+      ...headers,
+    },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+}
+const noFetch = () => {
+  throw new Error("unexpected external request");
+};
+test("pilot is disabled by default and a shared brand profile is not an individual", async () => {
+  const disabled = await handleCrmPilot(incoming("availability"), {}, noFetch);
+  assert.deepEqual(await disabled.json(), { enabled: false, business_id: null });
+  assert.equal((await handleCrmPilot(incoming("inbox"), {}, noFetch)).status, 404);
+  for (const actor of ["briosos", "tanaka", "admin"]) {
+    assert.equal(
+      (
+        await handleCrmPilot(
+          incoming("session", { method: "POST", body: {} }),
+          { ...env, CRM_PILOT_OPERATOR_ID: actor },
+          noFetch,
+        )
+      ).status,
+      503,
+    );
+  }
+  assert.equal(
+    (
+      await handleCrmPilot(
+        incoming("inbox"),
+        { ...env, PASSWORD_ADMIN: env.CRM_PILOT_OPERATOR_SECRET },
+        noFetch,
+      )
+    ).status,
+    503,
+  );
+});
+test("dedicated credential authenticates only the configured individual", async () => {
+  assert.equal(
+    (
+      await handleCrmPilot(
+        incoming("session", { method: "POST", body: {}, auth: "wrong" }),
+        env,
+        noFetch,
+      )
+    ).status,
+    401,
+  );
+  const response = await handleCrmPilot(
+    incoming("session", { method: "POST", body: {} }),
+    env,
+    noFetch,
+  );
+  assert.deepEqual(await response.json(), {
+    profile: "employee-pilot-001",
+    business_id: "briosos",
+  });
+  assert.equal(response.headers.get("cache-control"), "no-store");
+});
+test("proxy signs exact short HS256 claims and strips all browser credentials/headers", async () => {
+  let calls = 0;
+  const response = await handleCrmPilot(
+    incoming("inbox?bucket=awaiting_human&limit=1", {
+      headers: {
+        Origin: "https://frontend.example",
+        "Sec-Fetch-Site": "same-origin",
+        Cookie: "sensitive=private",
+        "X-Bot": "tanaka",
+        "X-CRM-Bot-Secret": "untrusted",
+        "X-CRM-Source-Secret": "untrusted",
+      },
+    }),
+    env,
+    async (url, init) => {
+      calls++;
+      assert.equal(url.origin, "https://crm.example");
+      assert.equal(url.pathname, "/v1/inbox");
+      assert.equal(url.searchParams.get("business_id"), "briosos");
+      const headers = new Headers(init.headers);
+      for (const name of [
+        "origin",
+        "sec-fetch-site",
+        "cookie",
+        "x-bot",
+        "x-crm-bot-secret",
+        "x-crm-source-secret",
+      ])
+        assert.equal(headers.has(name), false);
+      const token = headers.get("authorization").slice(7);
+      assert.equal(token.includes(env.CRM_PILOT_OPERATOR_SECRET), false);
+      const [header, body, signature] = token.split(".");
+      assert.deepEqual(JSON.parse(Buffer.from(header, "base64url")), { alg: "HS256", typ: "JWT" });
+      const claims = JSON.parse(Buffer.from(body, "base64url"));
+      assert.equal(claims.iss, "chatty-catalog-compass");
+      assert.equal(claims.aud, "whatsapp-crm");
+      assert.equal(claims.profile, "employee-pilot-001");
+      assert.deepEqual(claims.allowed_businesses, ["briosos"]);
+      assert.equal(claims.exp - claims.iat, 120);
+      assert.ok(Math.abs(claims.iat - Math.floor(Date.now() / 1000)) <= 1);
+      assert.equal(
+        signature,
+        createHmac("sha256", env.CRM_JWT_SECRET).update(`${header}.${body}`).digest("base64url"),
+      );
+      assert.equal(init.redirect, "error");
+      assert.equal(init.cache, "no-store");
+      return Response.json({ items: [], next_cursor: null });
+    },
+  );
+  assert.equal(response.status, 200);
+  assert.equal(calls, 1);
+});
+test("cross-site and cross-tenant input cannot select an upstream destination", async () => {
+  assert.equal(
+    (
+      await handleCrmPilot(
+        incoming("inbox", { headers: { Origin: "https://attacker.example" } }),
+        env,
+        noFetch,
+      )
+    ).status,
+    403,
+  );
+  assert.equal(
+    (
+      await handleCrmPilot(
+        incoming("inbox", { headers: { "Sec-Fetch-Site": "cross-site" } }),
+        env,
+        noFetch,
+      )
+    ).status,
+    403,
+  );
+  for (const path of ["inbox?business_id=tanaka", "inbox?business_id=briosos&business_id=velvet"]) {
+    assert.equal((await handleCrmPilot(incoming(path), env, noFetch)).status, 403);
+  }
+  for (const path of ["inbox?backend_url=https://attacker.example", "inbox?actor=admin"]) {
+    assert.equal((await handleCrmPilot(incoming(path), env, noFetch)).status, 400);
+  }
+  for (const path of [
+    "internal/sync",
+    "https://attacker.example",
+    "conversations/contact%2Fother/control",
+    "conversations/contact%252Fother/control",
+    "conversations/contact/commands/not/valid",
+  ]) {
+    assert.equal((await handleCrmPilot(incoming(path), env, noFetch)).status, 404);
+  }
+});
+test("method and body allowlists prohibit extra actor/credential/URL fields", async () => {
+  assert.equal(
+    (
+      await handleCrmPilot(
+        incoming("conversations/573000000001/control", { method: "POST", body: {} }),
+        env,
+        noFetch,
+      )
+    ).status,
+    405,
+  );
+  assert.equal(
+    (await handleCrmPilot(incoming("conversations/573000000001/messages"), env, noFetch)).status,
+    405,
+  );
+  for (const extra of [
+    "actor",
+    "business_id",
+    "url",
+    "credentials",
+    "expected_business",
+    "backend_url",
+  ]) {
+    const body = {
+      command_id: "synthetic-command-1",
+      expected_version: 3,
+      text: "SYNTHETIC answer",
+      [extra]: "untrusted",
+    };
+    assert.equal(
+      (
+        await handleCrmPilot(
+          incoming("conversations/573000000001/messages", { method: "POST", body }),
+          env,
+          noFetch,
+        )
+      ).status,
+      400,
+    );
+  }
+});
+test("opaque contact identifiers remain intact and a failed send is never called delivered", async () => {
+  const response = await handleCrmPilot(
+    incoming("conversations/CO.SyntheticID/messages", {
+      method: "POST",
+      body: { command_id: "synthetic-command-2", expected_version: 3, text: "SYNTHETIC answer" },
+    }),
+    env,
+    async (url, init) => {
+      assert.equal(url.pathname, "/v1/conversations/briosos/CO.SyntheticID/messages");
+      assert.deepEqual(JSON.parse(init.body), {
+        command_id: "synthetic-command-2",
+        expected_version: 3,
+        text: "SYNTHETIC answer",
+      });
+      return Response.json({ command_id: "synthetic-command-2", status: "failed", control: null });
+    },
+  );
+  assert.equal(response.status, 200);
+  assert.equal((await response.json()).status, "failed");
+});
+test("ambiguous POST is attempted once and becomes query-only unknown", async () => {
+  let calls = 0;
+  const response = await handleCrmPilot(
+    incoming("conversations/573000000001/messages", {
+      method: "POST",
+      body: { command_id: "synthetic-timeout", expected_version: 3, text: "SYNTHETIC answer" },
+    }),
+    env,
+    async () => {
+      calls++;
+      throw new TypeError("synthetic network timeout");
+    },
+  );
+  assert.equal(calls, 1);
+  assert.equal(response.status, 202);
+  assert.deepEqual(await response.json(), {
+    command_id: "synthetic-timeout",
+    status: "unknown",
+    control: null,
+    provider_message_id: null,
+    error: "proxy_outcome_unknown_query_command",
+  });
+});
+test("server rejects unsafe origin configuration instead of following a redirect", async () => {
+  for (const url of [
+    "http://crm.example",
+    "https://user:password@crm.example",
+    "https://crm.example/api",
+    "https://crm.example?token=private",
+  ]) {
+    assert.equal(
+      (await handleCrmPilot(incoming("inbox"), { ...env, CRM_BACKEND_URL: url }, noFetch)).status,
+      503,
+    );
+  }
+});
+test("composer requires confirmed current ownership, pause and a sendable window", () => {
+  const control = {
+    business_id: "briosos",
+    phone_number: "573000000001",
+    provider: "crm",
+    phase: "human",
+    version: 3,
+    owner: "employee-pilot-001",
+    is_paused: true,
+    confirmed: true,
+    can_send: true,
+    window_expires_at: "2030-01-01T00:00:00Z",
+  };
+  assert.equal(canCompose(control, "employee-pilot-001", null), true);
+  for (const change of [
+    { phase: "pausing" },
+    { owner: "other" },
+    { is_paused: false },
+    { confirmed: false },
+    { can_send: false },
+  ]) {
+    assert.equal(canCompose({ ...control, ...change }, "employee-pilot-001", null), false);
+  }
+  for (const status of ["unknown", "pending"]) {
+    const command = { command_id: "synthetic", status, control: null };
+    assert.equal(commandUnsettled(command), true);
+    assert.equal(canCompose(control, "employee-pilot-001", command), false);
+  }
+  assert.equal(canCompose(control, "other", null), false);
+});
+
+test("rotating the personal pilot credential revokes it on the next request", async () => {
+  const changed = { ...env, CRM_PILOT_OPERATOR_SECRET: "synthetic-rotated-" + "r".repeat(40) };
+  const response = await handleCrmPilot(incoming("inbox"), changed, noFetch);
+  assert.equal(response.status, 401);
+});
