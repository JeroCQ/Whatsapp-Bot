  "components": {
    "schemas": {
      "CRMUpdate": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version"
        ],
        "title": "CRMUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoteInput": {
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "body"
        ],
        "title": "NoteInput"
      },
      "PreferencesInput": {
        "properties": {
          "business_id": {
            "type": "string",
            "title": "Business Id"
          },
          "in_app": {
            "type": "boolean",
            "title": "In App",
            "default": true
          },
          "web_push": {
            "type": "boolean",
            "title": "Web Push",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "business_id"
        ],
        "title": "PreferencesInput"
      },
      "PushInput": {
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 4096,
            "title": "Endpoint"
          },
          "keys": {
            "$ref": "#/components/schemas/PushKeys"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "endpoint",
          "keys"
        ],
        "title": "PushInput"
      },
      "PushKeys": {
        "properties": {
          "p256dh": {
            "type": "string",
            "maxLength": 200,
            "minLength": 80,
            "pattern": "^[A-Za-z0-9_-]+=*$",
            "title": "P256Dh"
          },
          "auth": {
            "type": "string",
            "maxLength": 100,
            "minLength": 20,
            "pattern": "^[A-Za-z0-9_-]+=*$",
            "title": "Auth"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "p256dh",
          "auth"
        ],
        "title": "PushKeys"
      },
      "ReadInput": {
        "properties": {
          "read": {
            "type": "boolean",
            "title": "Read",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ReadInput"
      },
      "SyncInput": {
        "properties": {
          "business_id": {
            "type": "string",
            "maxLength": 63,
            "minLength": 1,
            "title": "Business Id"
          },
